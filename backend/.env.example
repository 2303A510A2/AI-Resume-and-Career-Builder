# Backend environment configuration - copy to .env and fill in real values.

PORT=5000
NODE_ENV=development
# Comma-separated origins. In development, any localhost/127.0.0.1 origin is
# also accepted automatically (plus the null origin from file:// pages);
# production uses only this list (no wildcard).
CLIENT_URL=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:5173

# MongoDB. Both MONGO_URI and MONGODB_URI are accepted (MONGODB_URI is the
# spec convention). If Mongo is down at startup the API still starts and
# /api/health reports mongodb: disconnected; it reconnects automatically
# (MONGO_RETRY_MS controls the reconnect interval).
MONGO_URI=mongodb://127.0.0.1:27017/ai_resume_career_builder
MONGODB_URI=
MONGO_RETRY_MS=10000

# Security - use long random strings in production
JWT_SECRET=change-me
JWT_RESET_SECRET=change-me-too
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# ---- LLM / AI provider (Drives the REAL AI chat responses) ----
# The chat endpoint POST /api/ai/career-assistant calls this OpenAI-compatible
# /chat/completions endpoint. Without a key the API returns an honest 503 —
# answers are NEVER simulated or templated locally.
#
# Canonical variables (most preferred first):
#   LLM_API_KEY    <- the one to set
#   LLM_BASE_URL
#   LLM_MODEL
# Compatible aliases are also accepted with a clear fallback chain:
#   apiKey  = LLM_API_KEY || AI_API_KEY || GROQ_API_KEY || OPENAI_API_KEY
#   baseUrl = LLM_BASE_URL || AI_BASE_URL
#   model   = LLM_MODEL    || AI_MODEL
#
# Recommended (fast + free): Groq — get a key at https://console.groq.com/keys
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b      # fast, vision-capable default (verified live)
#   LLM_API_KEY=gsk_...
#
# Model notes: the default qwen/qwen3.8-27b answers in ~150-600ms and accepts
# image attachments (vision). openai/gpt-oss-120b (the text-only reasoning
# flagship) is still supported but much slower (~8s per call), burns the free-tier
# token budget quickly and has NO vision — set it explicitly only if you want it:
#   LLM_MODEL=openai/gpt-oss-120b
# llama-3.3-70b-versatile is Enterprise-only on Groq today. The backend probes
# GET /models on startup and /api/health reports aiModelAvailable so you always
# know whether the configured LLM_MODEL is valid for your key.
#
# Alternatives (same shape, different base URL/model):
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   Ollama:  LLM_PROVIDER=ollama  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Optional override for outbound HTTPS when a network stalls during TLS 1.3.
# Leave empty for Node's default; set TLSv1.2 only when provider handshakes time out.
LLM_TLS_MAX_VERSION=
# Per-attempt provider timeout. This is now only the FLOOR: the real timeout is
# derived from the requested output budget (LLM_TOKENS_PER_SEC_BUDGET) and capped
# by LLM_LONG_TIMEOUT_MS, so "explain in 2000 words" or "100 interview questions"
# is never aborted mid-generation. The whole request (all attempts + backoff) is
# additionally capped by LLM_REQUEST_DEADLINE_MS, itself derived from the per
# attempt timeout, so a request can never hang the way exhausted-daily-quota 429s
# used to.
LLM_TIMEOUT_MS=20000
LLM_LONG_TIMEOUT_MS=180000
# Pessimistic generation rate used to turn a token budget into a wall-clock
# allowance (tokens/sec). Lower = more generous timeout, slower failures.
LLM_TOKENS_PER_SEC_BUDGET=45
LLM_REQUEST_DEADLINE_MS=25000
LLM_MAX_RETRIES=2
# Per-minute 429 (RPM/TPM) handling. The provider states exactly how long to wait
# ("Please try again in 18.33s"); the retry honors that (from the retry-after
# header or the error body) up to this cap, then succeeds once the window clears
# instead of re-hitting the same exhausted minute. Raise it to wait longer for a
# busy free tier (a hint beyond the cap fails fast to the fallback/error).
LLM_RATE_LIMIT_MAX_WAIT_MS=40000
# Absolute ceiling for ONE completion's max_tokens, whatever the user asked for.
# The per-request budget is computed from the request and clamped to this.
LLM_MAX_OUTPUT_TOKENS=32768
# Provider token ceilings for one request. Groq defaults are 8,000 input and
# 1,000 output tokens for the current low-tier deployment; override these when
# the selected model/account exposes different limits. Requests are trimmed
# and max_tokens is capped before every provider fetch.
LLM_INPUT_TOKEN_LIMIT=8000
LLM_OUTPUT_TOKEN_LIMIT=1000
# Automatic internal continuation attempts when the provider still cuts a long
# answer short (finish_reason "length") or the answer is verifiably incomplete.
# Each attempt is provider-only: the instruction is never stored or shown, and the
# merged result is persisted as ONE message. An incomplete result remains marked
# in chat history with a Continue response action. 0 disables it; hard cap 6.
LLM_MAX_CONTINUATIONS=5
# Automatic retries for a temporary provider failure during an internal
# continuation. Daily quota failures are never retried. The retry honors the
# provider Retry-After hint when it is within this bound, then uses bounded
# exponential backoff with jitter.
LLM_CONTINUATION_RATE_RETRIES=2
LLM_CONTINUATION_RATE_LIMIT_MAX_WAIT_MS=40000
# Health-probe timeout/cache for the provider reachability check (GET /models).
# Groq's /models list is slow under Node sometimes (~9.5s), so keep the timeout
# comfortably above 5s or /api/health will misreport the provider as unreachable.
LLM_PROBE_TIMEOUT_MS=20000
LLM_PROBE_CACHE_MS=60000

# ---- Safe provider diagnostics (development only) ----
# Three dev logs make "did ONE user message cost ONE provider request?" and
# "what did the provider REALLY say?" answerable from the backend console:
#   [AI REQUEST]  provider / model / kind(text|image) / user / requestId
#                 — exactly one line per real user message (a deduped duplicate
#                 requestId prints none, because it never reaches the provider)
#   [AI RESPONSE] status=200 provider / model / requestId / attempts / latency / finish
#   [AI ERROR]    requestId / provider / model / the RAW provider http status
#                 (429, 500, …) / the client status / attempts / code /
#                 rate-limit type (daily|requests|tokens) + the provider's own
#                 reason, key- and Bearer-scrubbed
#   [AI] Primary provider: <id>          — which provider each request targets
#   [AI] Primary provider unavailable: <id> / Fallback provider: <id>
#                                        — when the fallback took over (§9)
#   [AI FALLBACK] provider=<id> model=<id>   — explicit switch marker (§9)
#   [AI RESPONSE] status=200 provider=<id>   — served answer (success marker)
# They never print the API key, the Authorization header, a JWT, the prompt or
# MongoDB credentials. Automatically OFF when NODE_ENV=production; silence them
# in development with PROVIDER_LOG=0.
PROVIDER_LOG=1
AI_API_KEY=
AI_MODEL=

# ---- Fallback AI provider (optional, automatic) ----
# Multi-provider safety net: when the PRIMARY provider is temporarily unavailable
# AFTER its own retries — a spent daily quota, a per-minute rate limit, 5xx or a
# network failure — ONE clean attempt is made with the fallback provider before
# returning a friendly error. The fallback receives the SAME system prompt,
# conversation history, RAG context, user message, format and quantity
# requirements as the primary. User/auth/config errors (400, 401, 403, 404) NEVER
# switch providers. All vars optional; empty = no fallback.
#   A) Same-key fallback: set ONLY LLM_FALLBACK_MODEL (optionally LLM_FALLBACK_BASE_URL)
#      to reuse LLM_API_KEY with a DIFFERENT model. Ideal when the primary model's
#      daily token quota is exhausted but the account key still serves other
#      models (Groq per-model TPD). Example:
#        LLM_FALLBACK_MODEL=openai/gpt-oss-20b
#   B) Fully separate provider: give it its OWN key, base URL and model. Never
#      silently reuses the primary key, never an invented/guessed key:
#        LLM_FALLBACK_PROVIDER=openai
#        LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
#        LLM_FALLBACK_MODEL=gpt-4o-mini
#        LLM_FALLBACK_API_KEY=
#      Declaring LLM_FALLBACK_PROVIDER WITHOUT LLM_FALLBACK_API_KEY is treated
#      as an INCOMPLETE config: no fallback is attempted at all (the primary key
#      is never sent to a foreign endpoint).
# When both providers fail, the surfaced error carries the true cause: if a
# daily-quota error is involved it is the honest "Today's AI provider quota has
# been reached" message (retryable:false, never "temporarily unavailable");
# otherwise "AI services are temporarily unavailable" with Retry only when a
# retry could genuinely help.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Fallback provider 2 — makes the fallback a CHAIN (PRIMARY -> FALLBACK 1 ->
# FALLBACK 2) so the app answers whenever ANY configured provider has quota.
# Same rules as Fallback 1 (own key required with a declared provider; the
# primary key is never sent to a foreign endpoint; exactly ONE attempt per
# slot per user message). A clear error is surfaced only when EVERY configured
# provider fails. All vars optional; empty slot = skipped in the chain.
#   LLM_FALLBACK2_PROVIDER=openrouter
#   LLM_FALLBACK2_BASE_URL=https://openrouter.ai/api/v1
#   LLM_FALLBACK2_MODEL=openai/gpt-4o-mini
#   LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_PROVIDER=
LLM_FALLBACK2_BASE_URL=
LLM_FALLBACK2_MODEL=
LLM_FALLBACK2_API_KEY=

# ---- Vision (image analysis in chat) ----
# Set LLM_VISION=1 to allow image attachments to be analyzed by a vision-capable
# model. On Groq, openai/gpt-oss-120b and openai/gpt-oss-20b are TEXT-ONLY (400
# error on image parts); the default vision model qwen/qwen3.8-27b DOES accept
# images (verified live: real 200 + grounded pixel analysis). Generic vision
# patterns for other OpenAI-compatible providers include gpt-4o*, gpt-4.1*,
# llama-3.2-*-vision, llama-4*, qwen*-vl, pixtral, moondream, gemini*. The old
# llama-3.2-11b-vision-preview is decommissioned on Groq.
#
# Recommended split for the Groq free tier: keep LLM_MODEL on a fast text model
# (e.g. openai/gpt-oss-20b, generous combined TPM) for plain chat and set
# LLM_VISION_MODEL to the vision-capable model — image requests automatically use
# LLM_VISION_MODEL instead of the text primary, so chat stays cheap and images
# still get real pixel analysis. When vision is off (LLM_VISION unset) or no
# vision-capable model is available, attached images are stored for preview but
# the AI honestly says it cannot analyze them.
LLM_VISION=1
# Per-request vision model used ONLY for messages with attached images.
# (Primary text model: see LLM_MODEL above.)
LLM_VISION_MODEL=qwen/qwen3.8-27b
# Maximum size of a stored image attachment in bytes (raw, before base64).
LLM_VISION_MAX_IMAGE_BYTES=1500000

# Duplicate-request protection (per user message):
# The frontend sends a unique requestId for every message. The backend keeps an
# in-memory record of recently completed requestIds for this many ms, so a
# duplicate (double-click, React re-render, client retry) NEVER triggers a second
# LLM call or double message history.
REQUEST_DEDUP_TTL_MS=60000

# ---- Voice ---------------------------------------------------------------
# Speech-to-text uses the same Groq key (LLM_API_KEY) and the currently
# supported transcription model (default whisper-large-v3-turbo). No extra
# key needed. The frontend mic button records audio -> POST /api/ai/transcribe
# -> transcript -> normal AI pipeline.
LLM_STT_MODEL=whisper-large-v3-turbo
# Text-to-speech for the [ Listen ] button on AI answers. Leave LLM_TTS_MODEL
# EMPTY to use the browser speechSynthesis fallback (always works, no calls).
# To use Groq TTS instead, set a supported model (e.g. playai-tts) and voice:
LLM_TTS_MODEL=
LLM_TTS_VOICE=Sonia

# ---- Image generation (real images in the chat) ----
# "Create an image of ...", "draw ...", "make it at night" are detected in
# services/imageIntent.js and generated on the BACKEND by services/imageService.js
# (POST /api/ai/generate-image). The provider key stays on the server: it is
# never logged, never returned to a client and never shipped to the browser.
#
# IMAGE_PROVIDER = pollinations | openai | gemini   (default: pollinations)
#   pollinations  https://image.pollinations.ai/prompt/{prompt}  (no key needed)
#   openai        POST {base}/images/generations                  (needs key)
#   gemini        POST {base}/models/{model}:generateContent      (needs key)
# Set IMAGE_MODEL / IMAGE_BASE_URL to point at a different model or a
# self-hosted/OpenAI-compatible image endpoint. Nothing is hard-coded.
IMAGE_PROVIDER=pollinations
# Only openai/gemini need a key. Pollinations works key-less.
IMAGE_API_KEY=
IMAGE_MODEL=flux
IMAGE_BASE_URL=
# Square output size in px for text-to-image (256-1536).
IMAGE_SIZE=1024
# Images are slow: keep the per-attempt timeout generous.
IMAGE_TIMEOUT_MS=90000
# Retries for transient provider failures (capacity spikes / 429 / 5xx).
IMAGE_MAX_RETRIES=2
# Hard cap on stored image bytes (bytes are stored base64 in MongoDB).
IMAGE_MAX_BYTES=8388608
# Quality suffix appended to the user's own prompt; the user's words are always
# preserved. Set to an empty value to send the prompt untouched.
IMAGE_PROMPT_SUFFIX=high quality, highly detailed
# Set to 1 to allow providers that cannot edit a reference image to still answer
# an image-to-image request from text alone (default: an honest "not supported").
IMAGE_EDIT_FALLBACK_TEXT=

# ---- Web search (optional) ----
# Used when the user asks for CURRENT or external content ("places to visit in
# Hyderabad", "best websites for SQL practice", "latest resources"). When empty,
# the assistant honestly answers from its curated VERIFIED resource registry and
# never invents a URL. When set, every result URL is sanitized against the same
# trusted-host allowlist before it reaches the UI. The key stays server-side.
# Supported provider: tavily (get a free key at https://tavily.com)
#
# GROQ NATIVE MODE (no key needed): leave WEB_SEARCH_PROVIDER empty and set
# LLM_PROVIDER=groq (with openai/gpt-oss-120b). The assistant then uses Groq's
# built-in browser_search tool for current-information / travel / resource
# questions — the model decides when to search and Groq executes it server-side.
# If the search round trip is unavailable the assistant answers HONESTLY from its
# verified registry instead of pretending to have searched the web.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=12000

# ---- Embeddings (optional) ----
# Used for semantic RAG (Atlas $vectorSearch). Groq/Ollama have no embeddings
# API, so leave EMBEDDING_API_KEY empty there: RAG falls back to honest keyword
# search automatically. For full vector RAG set an OpenAI-compatible embeddings
# provider and create the Atlas index (see scripts/setupVectorIndex.js).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Email (SMTP). Leave EMAIL_USER/EMAIL_PASSWORD empty for console delivery (dev only).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# RAG tuning
RAG_TOP_K=6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Optional: bootstrap an admin account on startup
# ---- Main Admin Leader (secure one-time bootstrap) ----
# Read ONLY on the backend. Exactly one Main Admin Leader is created; if one
# already exists these are ignored (never overwritten / never password-reset on
# restart). The initial password MUST be changed at first login. If an ordinary
# account already uses INITIAL_ADMIN_EMAIL it is promoted once (server-side env
# only) and its password is set to the initial value.
INITIAL_ADMIN_NAME=Main Admin Leader
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisInitialPassword
# Admin session lifetime (separate from the user JWT). Default 8h.
ADMIN_JWT_EXPIRES_IN=8h

# Legacy admin vars (fallback only for the INITIAL_ADMIN_* values above).
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@careerai.app
ADMIN_PASSWORD=Admin@12345