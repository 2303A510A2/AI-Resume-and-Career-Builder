{
  "name": "ai-resume-career-builder-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Resume & Career Builder (Express + MongoDB + RAG)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "smoke": "node scripts/smokeTest.js",
    "test:cors": "node scripts/corsOfflineTest.js",
    "test:server-config": "node scripts/serverConfigTest.js",
    "test:provider-config": "node scripts/providerConfigTest.js",
    "test:chat-path": "node scripts/chatPathTest.js",
    "test:offline-port": "node scripts/portConflictTest.js",
    "test:output": "node scripts/outputRequirementsTest.js",
    "test:intent": "node scripts/intentTest.js",
    "setup-vector-index": "node scripts/setupVectorIndex.js"
  },
  "nodemonConfig": {
    "ignore": [
      "scripts/**",
      "tests/**",
      "coverage/**",
      "node_modules/**"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.4.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
