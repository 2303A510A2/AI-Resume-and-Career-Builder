# Frontend environment configuration — copy to .env and adjust.

# LOCAL DEVELOPMENT: points the app at the local backend API.
VITE_API_URL=http://localhost:5000/api

# PRODUCTION (Vercel host): set VITE_API_URL to the REAL deployed backend, e.g.
#   VITE_API_URL=https://your-backend.onrender.com/api
#
# Vite inlines VITE_API_URL at BUILD time, so it must be set in the hosting
# dashboard (Project → Settings → Environment Variables) BEFORE each production
# build. Without it, a production build REFUSES to call localhost or any guessed
# URL (see src/services/apiBase.js): requests fail fast with a clear
# "no backend API URL configured" state and the UI reports the backend as
# offline until the URL is configured.
#
# No-rebuild emergency fix: from the browser console on the deployed page run
#   window.APP_API_BASE = 'https://your-backend.onrender.com/api';
# then press "Retry Connection". This runtime override is read on every request
# and is NOT persisted (a reload clears it).